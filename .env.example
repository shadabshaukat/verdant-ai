# Created as .env by `node scripts/verdant.mjs setup`; never put passwords here.
COMPOSE_PROJECT_NAME=verdant-dba
# demo includes the scenario primary/standby; production runs only the control plane and registered clusters.
DEPLOYMENT_MODE=demo
APP_HOST=127.0.0.1
APP_PORT=8090
APP_IMAGE=verdant-dba/app:1.2.0
# Leave empty: CLI matches the Linux host UID/GID for private secret mounts; Desktop defaults to 1000.
APP_UID=
APP_GID=

# bundled = portable CPU-only Docker Ollama; external = existing host/remote Ollama.
OLLAMA_MODE=bundled
# Set skip to start the GUI without local model downloads, then configure remote chat profiles there.
MODEL_SETUP=ensure
# Empty selects http://ollama:11434 (bundled) or http://host.docker.internal:11434 (external).
OLLAMA_URL=
# Optional separate endpoints; empty inherits OLLAMA_URL.
OLLAMA_CHAT_URL=
OLLAMA_EMBED_URL=
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text:v1.5
OLLAMA_IMAGE=ollama/ollama:0.40.11

# Model and indexing settings; this reference's vector schema is fixed at 768 dimensions.
PLANNER_TIMEOUT_MS=45000
PLANNER_CONTEXT_TOKENS=12288
PLANNER_MAX_TOKENS=300
OLLAMA_KEEP_ALIVE=30m
EMBEDDING_TIMEOUT_MS=12000
EMBEDDING_QUERY_TIMEOUT_MS=5000
SEMANTIC_RECALL_TIMEOUT_MS=1200
MEMORY_INDEX_INTERVAL_MS=15000
MEMORY_INDEX_BATCH_SIZE=100
MEMORY_EMBED_BATCH_SIZE=8
# Seeds only an untouched new database policy. Persisted operator policy wins on subsequent starts.
MONITOR_INTERVAL_SECONDS=15
DEMO_ENABLED=true

DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=8000
DB_QUERY_TIMEOUT_MS=10000
CONTROL_POOL_MAX=8
TARGET_POOL_MAX=4
SHUTDOWN_TIMEOUT_MS=10000

# Connection credentials are encrypted using .secrets/credential_key. Back up that key with the control database.
# Sign in using .secrets/admin_token. Never commit either file.
# Set this to the externally visible origin when putting Verdant behind an HTTPS reverse proxy.
VERDANT_PUBLIC_URL=
# Set true for HTTPS. Secure cookies are also enforced automatically for an HTTPS public URL.
VERDANT_COOKIE_SECURE=false
VERDANT_SESSION_SECONDS=28800
# Optional additional access tokens, at least 32 characters and different from the admin token.
VERDANT_OPERATOR_TOKEN=
VERDANT_VIEWER_TOKEN=
# Enable only for intentionally unencrypted private-network LLM endpoints. Local Ollama is supported without this.
VERDANT_ALLOW_INSECURE_ENDPOINTS=false
FLEET_MONITOR_INTERVAL_SECONDS=30
FLEET_HISTORY_DAYS=14
